APP_ENV=dev
LOG_LEVEL=INFO
AGENT_PORT=8001
DEFAULT_LOCALE=pt-BR
DEFAULT_TIMEZONE=America/Sao_Paulo
CATALOG_DB_ENABLED=true
CATALOG_DB_HOST=presearch-db
CATALOG_DB_PORT=5432
CATALOG_DB_NAME=presearch
CATALOG_DB_USER=presearch
CATALOG_DB_PASSWORD=presearch
CATALOG_DB_CONNECT_TIMEOUT_S=2
ERP_DB_ENABLED=false
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=5432
ERP_DB_NAME=soccol
ERP_DB_USER=change-me
ERP_DB_PASSWORD=change-me
ERP_DB_CONNECT_TIMEOUT_S=2
PRE_SEARCH_REVIEW_CAPTURE_ENABLED=true
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_MS=240000
LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=220
LLM_KEEP_ALIVE=1h
LLM_WARMUP_ENABLED=true
LLM_THINK=false
LLM_LOG_RAW_RESPONSE=false
LLM_CATEGORIES_FILE=
FT_DATASET_SLUG=pre-search-ft-v1
FT_TARGET_MODEL_PREFIX=pre-search-qwen2.5-ft
FT_GOLDEN_SET_FILE=docs/assets/datasets/pre_search_num_predict_golden_set.json
FT_TRAIN_COMMAND=
FT_PUBLISH_COMMAND=
FT_ACTIVE_ENV_FILE=.env
FT_OLLAMA_BASE_MODEL=qwen2.5:7b
FT_OLLAMA_ARTIFACT_KIND=adapter
FT_OLLAMA_ARTIFACT_PATH=
FT_OLLAMA_OUTPUT_DIR=.tmp/ollama_models
HF_TOKEN=
TRAINER_HF_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
TRAINER_LOAD_IN_4BIT=true
TRAINER_NUM_EPOCHS=2
TRAINER_BATCH_SIZE=1
TRAINER_EVAL_BATCH_SIZE=1
TRAINER_GRAD_ACCUM_STEPS=8
TRAINER_LEARNING_RATE=0.0001
TRAINER_WARMUP_RATIO=0.03
TRAINER_MAX_SEQ_LENGTH=1024
TRAINER_LOGGING_STEPS=5
TRAINER_SAVE_STEPS=50
TRAINER_EVAL_STEPS=50
TRAINER_SAVE_TOTAL_LIMIT=2
TRAINER_SEED=42
TRAINER_LORA_R=16
TRAINER_LORA_ALPHA=32
TRAINER_LORA_DROPOUT=0.05
TRAINER_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
TRAINER_GRADIENT_CHECKPOINTING=true
TRAINER_TRUST_REMOTE_CODE=false
TRAINER_REPORT_TO=none
TRAINER_NVIDIA_VISIBLE_DEVICES=all
TRAINER_NVIDIA_DRIVER_CAPABILITIES=compute,utility
