# Escolha apenas um cenario para AGENT_URL e REDIS_URL:
# Local (comm via uvicorn no host):
# AGENT_URL=http://localhost:8001/respond
# REDIS_URL=redis://localhost:6379/0
#
# Docker Compose (comm em container):
AGENT_URL=http://docker-agent:8001/respond
REDIS_URL=redis://redis:6379/0

DEFAULT_BRANCH_ID=1
HISTORY_LIMIT=6
SESSION_TTL_SECONDS=86400
AGENT_TIMEOUT_SECONDS=20
AGENT_RETRY_COUNT=1
# Use o mesmo valor de RESPOND_GATEWAY_API_KEY do docker-agent em producao.
AGENT_GATEWAY_API_KEY=
ENABLE_TEST_ENDPOINT=true
# API_KEY=change-me
LOG_LEVEL=INFO

# Publicacao da API do docker-comm no host.
# Em producao, se houver proxy reverso no mesmo servidor:
# COMM_BIND_HOST=127.0.0.1
# COMM_PORT=8002
COMM_BIND_HOST=127.0.0.1
COMM_PORT=8000

COMM_API_URL=http://docker-comm:8000
STREAMLIT_PORT=8501
STREAMLIT_BIND_HOST=127.0.0.1
STREAMLIT_SOURCE=webchat
REVIEW_API_URL=http://docker-agent:8001
# Use o mesmo valor definido como REVIEW_API_KEY no docker-agent.
REVIEW_API_KEY=
REVIEWED_BY=
